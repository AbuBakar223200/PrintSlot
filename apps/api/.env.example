# Copy this to .env and fill in your values. NEVER commit .env.

# Supabase PostgreSQL connection string (from Supabase dashboard → Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase project URL (from Supabase dashboard → Settings → API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Supabase anon/public key (from Supabase dashboard → Settings → API)
SUPABASE_ANON_KEY=eyJ...

# Supabase service role key — admin SDK, used by seed + push notifications (KEEP SECRET)
SUPABASE_SERVICE_KEY=eyJ...

# Supabase JWT secret (from Supabase dashboard → Settings → API → JWT Settings)
JWT_SECRET=your-jwt-secret

# Cloudinary (from Cloudinary dashboard → Settings → Access Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Platform Admin account — seeded once via npx prisma db seed
ADMIN_EMAIL=admin@printslot.com
ADMIN_PASSWORD=ChangeMe123!
