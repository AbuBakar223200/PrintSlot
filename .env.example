# ─── PrintSlot Environment Variables ───────────────────────────
# Copy this file to the appropriate .env location and fill in values.
# NEVER commit actual credentials to the repository.

# ═══════════════════════════════════════════════════════════════
# API (.env goes in apps/api/.env)
# ═══════════════════════════════════════════════════════════════

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
JWT_SECRET=your-supabase-jwt-secret

# Database (from Supabase → Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App
PORT=3000

# Seed — Platform Admin account
ADMIN_EMAIL=admin@printslot.com
ADMIN_PASSWORD=change-this-password

# ═══════════════════════════════════════════════════════════════
# Mobile (.env goes in apps/mobile/.env)
# ═══════════════════════════════════════════════════════════════

# Supabase (public keys only — NEVER put SERVICE_KEY here)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# API base URL (use your machine's local IP for device testing)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Optional for local push-notification registration. Must be a real EAS project UUID.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Expo SDK 51 CLI cache can crash under Node 22 while fetching dependency metadata.
# Keep API response caching off for local starts; Metro bundler cache still works.
EXPO_NO_CACHE=1
